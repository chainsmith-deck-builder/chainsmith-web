# Base URL of the chainsmith backend HTTP API.
#
# Use `/api` for local development — requests stay same-origin and Vite's
# dev proxy (vite.config.ts) forwards `/api/*` to
# VITE_DEV_API_PROXY_TARGET (stripping the prefix). In CI/production set
# this to the absolute backend URL so the deployed SPA can reach it
# directly.
VITE_API_BASE_URL=/api

# Dev-only: target the `/api/*` proxy forwards to.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Required: Supabase project URL and anon (publishable) key.
#
# These are PUBLIC by definition — Vite inlines every VITE_* var into the
# bundle. Per .claude/rules/security.md, the Supabase service-role key
# never appears in this repo. The web client uses the anon key only.
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
